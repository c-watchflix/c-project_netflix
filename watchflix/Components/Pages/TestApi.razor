@page "/test-api"
@rendermode InteractiveServer
@using watchflix.Services
@using watchflix.Models
@using watchflix.Repositories
@inject TmdbService TmdbService
@inject AdoFilm AdoFilmService 

<style>
    /* --- 1. FONDS D'ÉCRAN --- */
    .default-background {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background-image: url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=2070&auto=format&fit=crop');
        background-size: cover; background-position: center;
        z-index: -2;
        filter: brightness(0.3) blur(5px);
        transform: scale(1.1);
    }
    .movie-background {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background-size: cover; background-position: center;
        z-index: -1; 
        filter: brightness(0.4) blur(15px);
        transform: scale(1.1);
        transition: background-image 0.5s ease-in-out;
    }

    /* --- 2. LAYOUT RESPONSIVE & CENTRAGE --- */
    /* Utilisation de grid pour un centrage parfait et une gestion simplifiée */
    @@media (min-width: 992px) {
        body { overflow: hidden; } /* Bloque le scroll navigateur sur PC */
        .layout-wrapper {
            height: 100vh;
            width: 100vw;
            display: grid; /* Grid est souvent plus robuste pour le centrage */
            place-items: center; /* Centre verticalement et horizontalement */
            padding: 20px;
            box-sizing: border-box; /* Important pour que le padding ne s'ajoute pas à la largeur */
        }
        .glass-container {
            height: 80vh; /* Hauteur fixe */
            width: 100%;
            max-width: 1500px;
            overflow-y: auto; /* Scroll interne */
            scrollbar-width: none;
            /* Flexibilité interne pour le contenu */
            display: flex; 
            flex-direction: column;
        }
        .glass-container::-webkit-scrollbar { display: none; }
    }

    @@media (max-width: 991px) {
        .layout-wrapper { padding: 20px 10px; height: auto; display: block;}
        .glass-container { height: auto; overflow: visible; display: block;}
    }

    /* --- 3. DESIGN VERRE --- */
    .glass-container {
        background: rgba(20, 20, 20, 0.65);
        backdrop-filter: blur(25px);       
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        color: white;
        padding: 40px;
        position: relative;
    }

    /* --- 4. ANIMATIONS ZOOM --- */
    .anim-dive-in { animation: diveIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @@keyframes diveIn { from { opacity: 0; transform: scale(0.9) translateY(50px); } to { opacity: 1; transform: scale(1) translateY(0); } }

    .anim-zoom-out { animation: zoomOut 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @@keyframes zoomOut { from { opacity: 0; transform: scale(1.1); } to { opacity: 1; transform: scale(1); } }

    /* --- 5. ÉLÉMENTS UI --- */
    .search-pill {
        background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px; padding: 5px 5px 5px 25px;
        display: flex; align-items: center; backdrop-filter: blur(10px); transition: 0.3s;
        width: 100%; max-width: 500px;
    }
    .search-pill:focus-within { background: rgba(255, 255, 255, 0.2); box-shadow: 0 0 15px rgba(255,255,255,0.1); }
    .search-input { background: transparent; border: none; color: white; width: 100%; outline: none; font-size: 1.1rem; }
    .search-input::placeholder { color: rgba(255,255,255,0.6); }
    .search-btn {
        background: rgba(255,255,255,0.1); border: none; color: white;
        width: 45px; height: 45px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s;
    }
    .search-btn:hover { background: rgba(255,255,255,0.3); transform: scale(1.1); }

    .glass-btn {
        background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15);
        color: white; border-radius: 50px; padding: 10px 25px;
        backdrop-filter: blur(10px); transition: 0.2s; font-weight: 600;
        cursor: pointer; display: inline-flex; align-items: center; gap: 10px;
    }
    .glass-btn:hover { background: rgba(255, 255, 255, 0.25); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
    .btn-add { background: rgba(46, 204, 113, 0.15); border-color: rgba(46, 204, 113, 0.3); }
    .btn-add:hover { background: rgba(46, 204, 113, 0.3); }

    .glass-pill {
        display: inline-block; padding: 6px 14px; border-radius: 50px;
        font-size: 0.85rem; font-weight: 600; margin-right: 8px; margin-bottom: 8px;
        background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
    }
    .pill-accent { background: rgba(255, 100, 100, 0.25); color: #ffcccc; }
    .pill-info { background: rgba(100, 180, 255, 0.25); color: #cceeff; }
    .pill-success { background: rgba(100, 255, 150, 0.2); color: #ccffdd; }

    /* --- 6. COEUR & PARTICULES --- */
    .btn-heart {
        position: relative; width: 45px; height: 45px; border-radius: 50%;
        background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #ff6b6b; cursor: pointer; transition: 0.3s; margin-left: 15px;
        z-index: 100;
    }
    .btn-heart:hover { background: rgba(255, 107, 107, 0.2); transform: scale(1.1); }
    
    .floating-heart {
        position: absolute; color: #ff6b6b; font-size: 1.2rem;
        /* Animation ajustée pour être visible même avec overflow: hidden sur le parent si possible, 
           sinon on compte sur le z-index élevé */
        animation: floatUp 1s ease-out forwards; opacity: 0; pointer-events: none;
        z-index: 1000; /* Très haut pour passer au-dessus de tout */
    }
    @@keyframes floatUp {
        0% { transform: translateY(0) scale(1); opacity: 1; }
        70% { opacity: 1; }
        100% { transform: translateY(-40px) scale(1.5); opacity: 0; }
    }

    /* --- 7. TOAST NOTIFICATION (RETOUR AU STYLE PILULE VERRE) --- */
    .toast-container {
        position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
        /* Style Verre Pilule */
        background: rgba(30, 30, 30, 0.75); /* Un peu plus opaque pour la lisibilité */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px; /* Coins un peu moins ronds pour la barre en bas */
        
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        display: flex; flex-direction: column;
        z-index: 20000; overflow: hidden; /* Important pour couper la barre en bas */
        animation: slideUp 0.3s ease-out;
        min-width: 350px;
    }
    
    .toast-content {
        display: flex; align-items: center; gap: 15px; 
        padding: 15px 25px; /* Padding confortable */
        width: 100%;
    }
    
    .toast-error .toast-icon { color: #ff6b6b; }
    .toast-success .toast-icon { color: #2ecc71; }
    .toast-text { color: white; font-weight: 500; font-size: 1rem; }
    
    /* Barre de progression en bas */
    .progress-bar {
        height: 4px; width: 100%; background: rgba(255,255,255,0.1);
        margin-top: 0; /* Pas de marge négative nécessaire si structuré en flex column */
    }
    .progress-fill {
        height: 100%; width: 100%;
        /* Animation qui réduit la largeur de 100% à 0% */
        animation: progress 3s linear forwards;
    }
    .toast-success .progress-fill { background: #2ecc71; box-shadow: 0 0 10px #2ecc71; } 
    .toast-error .progress-fill { background: #ff6b6b; box-shadow: 0 0 10px #ff6b6b; }

    @@keyframes slideUp { from { transform: translate(-50%, 50px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
    @@keyframes progress { from { width: 100%; } to { width: 0%; } }
    
    .shake-anim { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }
    @@keyframes shake {
        10%, 90% { transform: translateX(-52%); } 20%, 80% { transform: translateX(-48%); }
        30%, 50%, 70% { transform: translateX(-54%); } 40%, 60% { transform: translateX(-46%); }
    }

    /* --- 8. DIVERS --- */
    .movie-card {
        background: rgba(255, 255, 255, 0.05); border-radius: 16px; overflow: hidden;
        transition: 0.3s; border: 1px solid rgba(255,255,255,0.05); position: relative;
    }
    .movie-card:hover { transform: translateY(-8px); box-shadow: 0 10px 20px rgba(0,0,0,0.3); border-color: rgba(255,255,255,0.2); }
    .movie-title-overlay {
        position: absolute; bottom: 0; left: 0; width: 100%;
        background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
        padding: 20px 10px 10px 10px; text-align: center;
    }
    .music-track {
        display: flex; align-items: center; padding: 12px; border-radius: 12px;
        background: rgba(255, 255, 255, 0.03); margin-bottom: 10px;
        border: 1px solid rgba(255, 255, 255, 0.05); cursor: pointer; transition: 0.2s;
    }
    .music-track:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255,255,255,0.2); }

    .video-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 10000;
        display: flex; align-items: center; justify-content: center;
        animation: fadeIn 0.4s ease-out;
    }
    @@keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
</style>

@if (filmSelectionne == null) { <div class="default-background"></div> }
else { <div class="movie-background" style="background-image: url('@filmSelectionne.FullBackdropUrl');"></div> }

@if (afficherToast)
{
    <div class="toast-container @classeToast @(animShake ? "shake-anim" : "")">
        <div class="toast-content">
            <span class="toast-icon" style="font-size: 1.5rem;">@iconeToast</span>
            <span class="toast-text">@messageToast</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill"></div>
        </div>
    </div>
}

<div class="layout-wrapper">
    
    <div class="glass-container @(filmSelectionne != null ? "anim-dive-in" : "anim-zoom-out")">
        
        @if (filmSelectionne == null)
        {
            <div class="d-flex flex-column h-100">
                <div class="text-center mb-5">
                    <h2 class="display-5 fw-bold mb-4" style="text-shadow: 0 4px 10px rgba(0,0,0,0.5);">🎬 Recherche Films</h2>
                    <div class="d-flex justify-content-center">
                        <div class="search-pill">
                            <input @bind="nomDuFilm" @bind:event="oninput" @onkeypress="HandleEntree" class="search-input" placeholder="Titre du film (ex: Titanic)..." />
                            <button class="search-btn" @onclick="ChercherFilm">🔍</button>
                        </div>
                    </div>
                </div>

                @if (resultats != null)
                {
                    <div class="row g-4 px-4 pb-4" style="overflow-y: auto;">
                        @foreach (var film in resultats.Results)
                        {
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="movie-card h-100" @onclick="() => VoirDetails(film.Id)">
                                    <img src="@film.FullImageUrl" style="width:100%; aspect-ratio: 2/3; object-fit: cover;" />
                                    <div class="movie-title-overlay">
                                        <small class="fw-bold text-white">@film.Title</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (filmSelectionne != null)
        {
            <button class="glass-btn position-absolute top-0 start-0 m-4" @onclick="RetourListe">⬅ Retour</button>

            <div class="row h-100 align-items-start pt-5">
                
                <div class="col-lg-8 pe-lg-5" style="border-right: 1px solid rgba(255,255,255,0.1); height: 100%; overflow-y: auto;">
                    <div class="row">
                        <div class="col-md-4 text-center mb-4">
                            <img src="@filmSelectionne.FullPosterUrl" class="img-fluid rounded-4 shadow-lg" 
                                 style="width:100%; max-width: 350px; border: 1px solid rgba(255,255,255,0.2);">
                        </div>

                        <div class="col-md-8 ps-md-4">
                            <div class="d-flex align-items-center mb-2">
                                <h1 class="display-5 fw-bold m-0" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">@filmSelectionne.Title</h1>
                                
                                <div class="btn-heart" @onclick="ActiverCoeur">
                                    ❤
                                    @if(coeurActive) 
                                    {
                                        <span class="floating-heart" style="left: 10px; animation-delay: 0s;">❤</span>
                                        <span class="floating-heart" style="left: 20px; animation-delay: 0.1s;">❤</span>
                                        <span class="floating-heart" style="left: 30px; animation-delay: 0.2s;">❤</span>
                                    }
                                </div>
                            </div>

                            <p class="text-white-50 fs-5 mb-4">Réalisé par <span class="text-white">@(filmSelectionne.Realisateur ?? "Inconnu")</span></p>

                            <div class="mb-3">
                                <span class="glass-pill pill-info">📅 @filmSelectionne.AnneeSortie</span>
                                <span class="glass-pill pill-accent">⚠️ PEGI @filmSelectionne.Pegi</span>
                                <span class="glass-pill pill-info">⏱ @filmSelectionne.Runtime min</span>
                            </div>

                            <div class="mb-4">
                                @foreach(var genre in filmSelectionne.Genres.Take(4))
                                {
                                    <span class="glass-pill pill-success">@genre.Name</span>
                                }
                            </div>

                            <div class="p-4 rounded-4 mb-4" style="background: rgba(0,0,0,0.2);">
                                <h5 class="fw-bold text-uppercase fs-6 text-white-50 mb-2">Synopsis</h5>
                                <p class="text-light m-0" style="line-height: 1.6; font-size: 1rem;">
                                    @filmSelectionne.Overview
                                </p>
                            </div>

                            <div class="d-flex flex-wrap gap-3 pb-4">
                                @if (!string.IsNullOrEmpty(filmSelectionne.YoutubeKey))
                                {
                                    <button class="glass-btn px-4 py-3" @onclick="OuvrirTrailer">
                                        ▶ Bande Annonce
                                    </button>
                                }
                                <button class="glass-btn btn-add px-4 py-3" @onclick="AjouterALaBdd">
                                    ➕ Ajouter à ma Vidéothèque
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 ps-lg-5 d-flex flex-column h-100">
                    
                    <h3 class="mb-4 fw-light text-white-50" style="margin-top: 0;">🎵 Bande Originale</h3>
                    
                    <div style="max-height: 600px; overflow-y: auto; padding-right: 10px;">
                        @for(int i=1; i<=5; i++)
                        {
                            <div class="music-track">
                                <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: 8px; display:flex; align-items:center; justify-content:center; margin-right:12px; font-size: 1.2rem;">♫</div>
                                <div>
                                    <div class="fw-bold">Piste Musicale @i</div>
                                    <div style="font-size: 0.8rem; opacity: 0.6;">Artiste Inconnu</div>
                                </div>
                                <div class="ms-auto text-white-50">▶</div>
                            </div>
                        }
                        <div class="text-center mt-4 p-4 glass-btn w-100 text-info" style="cursor: default;">
                            <small>L'intégration Spotify arrive bientôt !</small>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>

@if (afficherTrailer && !string.IsNullOrEmpty(filmSelectionne.YoutubeKey))
{
    <div class="video-overlay" @onclick="FermerTrailer">
        <div style="position: relative; width: 85%; max-width: 1100px; aspect-ratio: 16/9;">
            <button class="glass-btn position-absolute top-0 end-0 m-n5" style="border-radius: 50%; width: 50px; height: 50px; justify-content: center;" @onclick="FermerTrailer">X</button>
            <iframe width="100%" height="100%" 
                    src="https://www.youtube.com/embed/@filmSelectionne.YoutubeKey?autoplay=1" 
                    frameborder="0" allow="autoplay; encrypted-media" allowfullscreen
                    style="border-radius: 20px; box-shadow: 0 0 80px rgba(0,0,0,1);">
            </iframe>
        </div>
    </div>
}

@code {
    private string nomDuFilm = "";
    private TmdbSearchResponse? resultats;
    private MovieDetails? filmSelectionne; 
    
    private bool afficherToast = false;
    private string messageToast = "";
    private string classeToast = "";
    private string iconeToast = "";
    private bool animShake = false;

    private bool afficherTrailer = false;
    private bool coeurActive = false;

    private async Task ChercherFilm()
    {
        if (string.IsNullOrWhiteSpace(nomDuFilm)) return;
        filmSelectionne = null;
        resultats = await TmdbService.SearchMovieByName(nomDuFilm);
    }

    private async Task HandleEntree(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ChercherFilm();
    }

    private async Task VoirDetails(int id)
    {
        filmSelectionne = await TmdbService.GetMovieDetails(id);
        afficherTrailer = false;
        coeurActive = false;
    }

    private async Task AjouterALaBdd()
    {
        if (filmSelectionne != null)
        {
            bool succes = await AdoFilm.addFilmWhithApi(filmSelectionne);
            if (succes) AfficherNotification("Film ajouté à votre vidéothèque !", "success");
            else AfficherNotification("Ce film est déjà dans votre collection !", "error");
        }
    }

    private async void AfficherNotification(string message, string type)
    {
        messageToast = message;
        afficherToast = true;
        animShake = false; 
        if (type == "success") { classeToast = "toast-success"; iconeToast = "✅"; }
        else { classeToast = "toast-error"; iconeToast = "⚠️"; animShake = true; }
        StateHasChanged();
        await Task.Delay(3000);
        afficherToast = false;
        StateHasChanged();
    }

    private async void ActiverCoeur()
    {
        coeurActive = true;
        StateHasChanged();
        await Task.Delay(1000);
        coeurActive = false;
        StateHasChanged();
    }

    private void OuvrirTrailer() => afficherTrailer = true;
    private void FermerTrailer() => afficherTrailer = false;

    private void RetourListe()
    {
        filmSelectionne = null;
        afficherTrailer = false;
    }
}