@page "/admin/videotheque-api"
@layout watchflix.Components.Layout.AdminLayout
@rendermode InteractiveServer
@using watchflix.Services
@using watchflix.Models
@using watchflix.Repositories
@inject TmdbService TmdbService
@inject YoutubeServiceOfficial2 YoutubeService
@inject AdoFilm AdoFilmService 
@inject NavigationManager Nav

@if (filmSelectionne == null) { <div class="default-background"></div> }
else { <div class="movie-background" style="background-image: url('@filmSelectionne.FullBackdropUrl');"></div> }

@if (afficherToast)
{
    <div class="toast-container @classeToast @(animShake ? "shake-anim" : "")">
        <div class="toast-content">
            <span class="toast-icon" style="font-size: 1.5rem;">@iconeToast</span>
            <span class="toast-text">@messageToast</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill"></div>
        </div>
    </div>
}

<div class="layout-wrapper">
    
    <div class="glass-container @(filmSelectionne != null ? "anim-dive-in" : "anim-zoom-out")">
        
        @if (filmSelectionne == null)
        {
            <div class="d-flex flex-column h-100">
                <div class="text-center mb-5">
                    <h2 class="display-5 fw-bold mb-4" style="text-shadow: 0 4px 10px rgba(0,0,0,0.5);">🎬 Recherche Films</h2>
                    
                    <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap">
                        <button class="glass-btn m-0" @onclick='() => Nav.NavigateTo("/admin/film")' style="padding: 10px 20px;">
                            ⬅ Retour pannel admin
                        </button>
                        
                        <div class="search-pill m-0">
                            <input @bind="nomDuFilm" @bind:event="oninput" @onkeypress="HandleEntree" class="search-input" placeholder="Titre du film (ex: Titanic)..." />
                            <button class="search-btn" @onclick="ChercherFilm">🔍</button>
                        </div>
                    </div>

                </div>

                @if (resultats != null)
                {
                    <div class="row g-4 px-4 pb-4" style="overflow-y: auto;">
                        @foreach (var film in resultats.Results)
                        {
                            <div class="col-6 col-md-3 col-lg-2">
                                <div class="movie-card h-100" @onclick="() => VoirDetails(film.Id)">
                                    <img src="@film.FullImageUrl" style="width:100%; aspect-ratio: 2/3; object-fit: cover;" />
                                    <div class="movie-title-overlay">
                                        <small class="fw-bold text-white">@film.Title</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (filmSelectionne != null)
        {
            <button class="glass-btn position-absolute top-0 start-0 m-4" @onclick="RetourListe">⬅ Retour</button>

            <div class="row h-100 align-items-start pt-5">
                
                <div class="col-lg-8 pe-lg-5" style="border-right: 1px solid rgba(255,255,255,0.1); height: 100%; overflow-y: auto;">
                    <div class="row">
                        <div class="col-md-4 text-center mb-4">
                            <img src="@filmSelectionne.FullPosterUrl" class="img-fluid rounded-4 shadow-lg" 
                                 style="width:100%; max-width: 350px; border: 1px solid rgba(255,255,255,0.2);">
                        </div>

                        <div class="col-md-8 ps-md-4">
                            <div class="d-flex align-items-center mb-2">
                                <h1 class="display-5 fw-bold m-0" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">@filmSelectionne.Title</h1>
                                
                                <div class="btn-heart" @onclick="ActiverCoeur">
                                    ❤
                                    @if(coeurActive) 
                                    {
                                        <span class="floating-heart" style="left: 10px; animation-delay: 0s;">❤</span>
                                        <span class="floating-heart" style="left: 20px; animation-delay: 0.1s;">❤</span>
                                        <span class="floating-heart" style="left: 30px; animation-delay: 0.2s;">❤</span>
                                    }
                                </div>
                            </div>

                            <p class="text-white-50 fs-5 mb-4">Réalisé par <span class="text-white">@(filmSelectionne.Realisateur ?? "Inconnu")</span></p>

                            <div class="mb-3">
                                <span class="glass-pill pill-info">📅 @filmSelectionne.AnneeSortie</span>
                                <span class="glass-pill pill-accent">⚠️ PEGI @filmSelectionne.Pegi</span>
                                <span class="glass-pill pill-info">⏱ @filmSelectionne.Runtime min</span>
                            </div>

                            <div class="mb-4">
                                @foreach(var genre in filmSelectionne.Genres.Take(4))
                                {
                                    <span class="glass-pill pill-success">@genre.Name</span>
                                }
                            </div>

                            <div class="p-4 rounded-4 mb-4" style="background: rgba(0,0,0,0.2);">
                                <h5 class="fw-bold text-uppercase fs-6 text-white-50 mb-2">Synopsis</h5>
                                <p class="text-light m-0" style="line-height: 1.6; font-size: 1rem;">
                                    @filmSelectionne.Overview
                                </p>
                            </div>

                            <div class="d-flex flex-wrap gap-3 pb-4">
                                @if (!string.IsNullOrEmpty(filmSelectionne.YoutubeKey))
                                {
                                    <button class="glass-btn px-4 py-3" @onclick="OuvrirTrailer">
                                        ▶ Bande Annonce
                                    </button>
                                }
                                <button class="glass-btn btn-add px-4 py-3" @onclick="AjouterALaBdd">
                                    ➕ Ajouter à ma Vidéothèque
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 ps-lg-5 d-flex flex-column h-100">
                    
                    <h3 class="mb-4 fw-light text-white-50" style="margin-top: 0;">🎵 Bande Originale</h3>
                    
                    @* ICI BANDE ORIGINALE  *@
                    <div style="max-height: 600px; overflow-y: auto; padding-right: 10px;">
                        @if (musiques.Count == 0)
                        {
                            <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: 8px; display:flex; align-items:center; justify-content:center; margin-right:12px; font-size: 1.2rem;">♫</div>
                                <div>
                                    <div class="fw-bold">Aucune musique trouvée</div>
                                    <div style="font-size: 0.8rem; opacity: 0.6;"> Durée : aucune </div>
                                    <div style="font-size: 0.8rem; opacity: 0.6;"> Album : aucun</div>
                                </div>
                        }
                        else
                        {
                            @foreach(var m in musiques)
                            {
                                <a href="@m.Lien" target="_blank" style="text-decoration:none; color:inherit;">
                                    <div class="music-track" style="cursor:pointer;">
                                        <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: 8px; display:flex; align-items:center; justify-content:center; margin-right:12px; font-size: 1.2rem;">♫</div>
                                        <div>
                                            <div class="fw-bold">@m.Titre</div>
                                            <div style="font-size: 0.8rem; opacity: 0.6;"> Durée : @m.Duree</div>
                                            <div style="font-size: 0.8rem; opacity: 0.6;"> Album : @m.Album</div>
                                        </div>
                                        <div class="ms-auto text-white-50" @onclick="() => AjouterALaBddMusic(m)"> Télécharger </div>
                                        <div class="ms-auto text-white-50">▶</div>
                                    </div>
                                </a>
                            }
                        }

                    </div>



                </div>

            </div>
        }
    </div>
</div>

@if (afficherTrailer && !string.IsNullOrEmpty(filmSelectionne.YoutubeKey))
{
    <div class="video-overlay" @onclick="FermerTrailer">
        <div style="position: relative; width: 85%; max-width: 1100px; aspect-ratio: 16/9;">
            <button class="glass-btn position-absolute top-0 end-0 m-n5" style="border-radius: 50%; width: 50px; height: 50px; justify-content: center;" @onclick="FermerTrailer">X</button>
            <iframe width="100%" height="100%" 
                    src="https://www.youtube.com/embed/@filmSelectionne.YoutubeKey?autoplay=1" 
                    frameborder="0" allow="autoplay; encrypted-media" allowfullscreen
                    style="border-radius: 20px; box-shadow: 0 0 80px rgba(0,0,0,1);">
            </iframe>
        </div>
    </div>
}

@code {
    private string nomDuFilm = "";
    private TmdbSearchResponse? resultats;
    private MovieDetails? filmSelectionne; 
    
    private bool afficherToast = false;
    private string messageToast = "";
    private string classeToast = "";
    private string iconeToast = "";
    private bool animShake = false;

    private bool afficherTrailer = false;
    private bool coeurActive = false;

    private List<Musique> musiques = new List<Musique>();

    private List<Musique> nouvellesMusiques = new List<Musique>();

    private async Task ChercherFilm()
    {
        if (string.IsNullOrWhiteSpace(nomDuFilm)) return;
        filmSelectionne = null;
        resultats = await TmdbService.SearchMovieByName(nomDuFilm);
    }

    private async Task HandleEntree(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ChercherFilm();
    }

    private async Task VoirDetails(int id)
    {
        filmSelectionne = await TmdbService.GetMovieDetails(id);
        afficherTrailer = false;
        coeurActive = false;
        nouvellesMusiques = await YoutubeService.SearchMusicAsync(@filmSelectionne.Title);
        musiques.AddRange(nouvellesMusiques);
    }

    private async Task AjouterALaBdd()
    {
        if (filmSelectionne != null)
        {
            bool succes = await AdoFilm.addFilmWhithApi(filmSelectionne);
            if (succes) AfficherNotification("Film ajouté à votre vidéothèque !", "success");
            else AfficherNotification("Ce film est déjà dans votre collection !", "error");
        }
    }
    private async Task AjouterALaBddMusic(Musique musique)
    {
        if (musiques != null)
        {
            bool success = await YoutubeService.SaveToDatabaseAsync(musique);
            if (success) AfficherNotification("Musique ajoutée à votre bibliothèque !", "success");
            else AfficherNotification("Cette musique est déjà dans votre collection !", "error");
        }
    }


    private async void AfficherNotification(string message, string type)
    {
        messageToast = message;
        afficherToast = true;
        animShake = false; 
        if (type == "success") { classeToast = "toast-success"; iconeToast = "✅"; }
        else { classeToast = "toast-error"; iconeToast = "⚠️"; animShake = true; }
        StateHasChanged();
        await Task.Delay(3000);
        afficherToast = false;
        StateHasChanged();
    }

    private async void ActiverCoeur()
    {
        coeurActive = true;
        StateHasChanged();
        await Task.Delay(1000);
        coeurActive = false;
        StateHasChanged();
    }

    private void OuvrirTrailer() => afficherTrailer = true;
    private void FermerTrailer() => afficherTrailer = false;

    private void RetourListe()
    {
        filmSelectionne = null;
        afficherTrailer = false;
        musiques.Clear();
    }
}