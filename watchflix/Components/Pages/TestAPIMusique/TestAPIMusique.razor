@page "/test-apimusique"
@rendermode InteractiveServer
@using watchflix.Models
@using watchflix.Repositories
@inject AdoMusique Repo

<PageTitle>API Musique</PageTitle>

<h1>Ici test API Musique</h1>

<button class="btn btn-primary" @onclick="GetAll">select all</button>
<button class="btn btn-primary"@onclick="GetOneByID">select id</button>
<button class="btn btn-primary"@onclick="GetOneByTitle">select 1 by name</button>



@if (data != null) //si la liste data n'est pas vide
{
    <h1>Toutes les musiques</h1>
    <ul>
        @foreach (var Musique in data) // alors pour chaque catégorie présente dans la liste
        {
            <li>@Musique.Titre</li> // je vais faire une ligne
        }
    </ul>
}
@if (OneByID != null) //si la liste data n'est pas vide
{
    <h1>ID des musiques</h1>
    <ul>
        {
            <li>@OneByID.Titre</li> // je vais faire une ligne
        }
    </ul>
}
@if (OneByTitle != null) //si la liste data n'est pas vide
{
    <h1>Noms des musiques</h1>
    <ul>
        @foreach (var musique in OneByTitle)
        {
            <li>@musique.Titre</li> // je vais faire une ligne
        }
    </ul>
}
@code {
    IEnumerable<Musique>? data;
    Musique? OneByID;
    IEnumerable<Musique>? OneByTitle;
   
private void GetAll()
{
    data = AdoMusique.GetAll();
}
private void GetOneByID()
{
    OneByID = AdoMusique.GetOneById(7);
}
private void GetOneByTitle()
{
   OneByTitle = AdoMusique.GetAllByTitle("test"); 
}

}
