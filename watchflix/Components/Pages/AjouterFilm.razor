@page "/ajouter-film"
@rendermode InteractiveServer
@using watchflix.Services
@using watchflix.Models
@using watchflix.Repositories
@inject TmdbService TmdbService
@inject AdoFilm AdoFilm
@inject NavigationManager Nav

<h3>📥 Ajouter un film à la base de données</h3>

<div class="input-group mb-3">
    <input @bind="nomDuFilm" class="form-control" placeholder="Titre du film..." />
    <button class="btn btn-primary" @onclick="ChercherFilm">Rechercher API</button>
</div>

@if (filmSelectionne == null && resultats != null)
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var film in resultats.Results)
        {
            <div class="card" style="width: 150px; cursor:pointer;" @onclick="() => VoirDetails(film.Id)">
                <img src="@film.FullImageUrl" class="card-img-top" style="height: 225px; object-fit: cover;">
                <div class="card-body p-2">
                    <p class="card-text small">@film.Title</p>
                </div>
            </div>
        }
    </div>
}

@if (filmSelectionne != null)
{
    <button class="btn btn-secondary mb-3" @onclick="() => filmSelectionne = null">Retour</button>

    <div class="card mb-3">
        <div class="row g-0">
            <div class="col-md-3">
                <img src="@filmSelectionne.FullPosterUrl" class="img-fluid rounded-start" 
                     style="width: 100%; height: auto; object-fit: cover;" alt="...">
            </div>
            <div class="col-md-9">
                <div class="card-body">
                    <h2 class="card-title">@filmSelectionne.Title</h2>
                    
                    <div class="mb-2 text-muted">
                        <span class="badge bg-primary">@filmSelectionne.AnneeSortie</span>
                        <span class="badge bg-secondary">@filmSelectionne.Runtime min</span>
                        <span class="badge bg-warning text-dark">PEGI: @filmSelectionne.Pegi</span>
                    </div>

                    <div class="mb-3">
                        @foreach(var g in filmSelectionne.Genres)
                        {
                            <span class="badge rounded-pill bg-info text-dark me-1">@g.Name</span>
                        }
                    </div>

                    <p class="card-text"><strong>Réalisateur :</strong> @(filmSelectionne.Realisateur ?? "Inconnu")</p>
                    <p class="card-text">@filmSelectionne.Overview</p>

                    @if (!string.IsNullOrEmpty(filmSelectionne.YoutubeKey))
                    {
                        <div class="ratio ratio-16x9 mb-3" style="max-width: 500px;">
                            <iframe src="https://www.youtube.com/embed/@filmSelectionne.YoutubeKey" allowfullscreen></iframe>
                        </div>
                    }

                    <hr/>
                    @if(messageSucces == "")
                    {
                        <button class="btn btn-success btn-lg" @onclick="SauvegarderEnBdd">
                            💾 ENREGISTRER DANS MA BDD
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-success">@messageSucces</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string nomDuFilm = "";
    private TmdbSearchResponse? resultats;
    private MovieDetails? filmSelectionne;
    private string messageSucces = "";

    private async Task ChercherFilm()
    {
        filmSelectionne = null;
        messageSucces = "";
        resultats = await TmdbService.SearchMovieByName(nomDuFilm);
    }

    private async Task VoirDetails(int id)
    {
        filmSelectionne = await TmdbService.GetMovieDetails(id);
    }

    private async Task SauvegarderEnBdd()
    {
        if(filmSelectionne != null)
        {
            await AdoFilm.addFilmWhithApi(filmSelectionne);
            messageSucces = "Film enregistré avec succès dans SQL Server !";
        }
    }
}