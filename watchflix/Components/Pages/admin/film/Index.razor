@page "/admin/film"
@rendermode InteractiveServer
@using watchflix.Models
@using watchflix.Repositories
@inject AdoFilm Repo
@inject NavigationManager Navigation

<PageTitle>Films</PageTitle>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary btn-lg" @onclick='() => Navigation.NavigateTo("/admin/videotheque-api")'>Ajouter un film</button>
</div>

@if (data != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Titre</th>
                <th scope="col">Réalisateur</th>
                <th scope="col">Date de sortie</th>
                <th scope="col">Durée</th>
                <th scope="col">Pegi</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(Film film in data)
            {
                <tr>
                    <td> @film.Titre </td>
                    <td> @film.Realisateur </td>
                    <td> @film.Dte_sortie.Split(" ")[^2] </td>
                    <td> @film.Duree </td>
                    <td> @film.Pegi </td>
                    <td>
                        <button class="btn btn-secondary" @onclick="() => OpenModal(film)">Voir détails</button>
                        <button class="btn btn-danger" @onclick="() => OpenDeleteModal(film)">Supprimer</button>
                    </td>
                </tr>  
            }

        </tbody>
    </table>

    
    @if (selectedFilm != null)
    {
        <div class="modal fade show"
            style="display:block">

            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4">
                    <!-- HEADER -->
                    <div class="modal-header border-0 pb-3 pt-4 px-4">

                        <div>
                            <h3 class="fw-bold mb-1 text-dark">
                                @selectedFilm.Titre
                            </h3>
                            <small class="text-muted">
                                Fiche détaillée du film
                            </small>
                        </div>

                        <button class="btn-close"
                                @onclick="CloseModal">
                        </button>
                    </div>

                    <!-- BODY -->
                    <div class="modal-body px-4">

                        <!-- Grid Infos -->
                        <div class="row g-4 mb-4">

                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block">
                                        Année de sortie
                                    </small>
                                    <span class="fw-semibold">
                                        @selectedFilm.Dte_sortie.Split(" ")[^2]
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block">
                                        Durée
                                    </small>
                                    <span class="fw-semibold">
                                        @selectedFilm.Duree min
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block">
                                        Réalisateur
                                    </small>
                                    <span class="fw-semibold">
                                        @selectedFilm.Realisateur
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="p-3 bg-light rounded-3">
                                    <small class="text-muted d-block">
                                        Classification
                                    </small>
                                    <span class="badge bg-danger px-3 py-2">
                                        @selectedFilm.Pegi
                                    </span>
                                </div>
                            </div>

                        </div>

                        <!-- Synopsis Card -->
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body">
                                <h5 class="fw-bold mb-3">
                                    Synopsis
                                </h5>
                                <p class="text-muted mb-0">
                                    @selectedFilm.Synopsys
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>  
        <!-- BACKDROP -->
        <div class="modal-backdrop fade show"></div> //fond grisé derrière les modales
    }

    @if (filmToDelete != null)
    {
        <div class="modal fade show"
            style="display:block; background-color:rgba(0,0,0,0.5);">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Confirmation</h5>
                        <button class="btn-close"
                                @onclick="CloseDeleteModal">
                        </button>
                    </div>

                    <div class="modal-body">
                        Voulez-vous vraiment supprimer le film :

                        <strong>
                            @filmToDelete.Titre
                        </strong> ?
                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-secondary"
                                @onclick="CloseDeleteModal">
                            Annuler
                        </button>

                        <button class="btn btn-danger"
                                @onclick="ConfirmDelete">
                            Supprimer
                        </button>

                    </div>

                </div>
            </div>
        </div>
    }

} 



@code {
    IEnumerable<Film>? data;
    IEnumerable<Film>? oneByID;
    IEnumerable<Film>? oneByName;
    Film? selectedFilm;
    Film? filmToDelete;

    protected override void OnInitialized()
    {
        data = AdoFilm.getAll();
    }

    private void GetOneByID()
    {
        oneByID = AdoFilm.getOneById(5);
    }

    private void GetOneByName()
    {
        oneByName = AdoFilm.getOneByName("Zootopie");
    }

    private void Delete(int Id_film)
    {
        AdoFilm.delete(Id_film);
        data = AdoFilm.getAll(); // refresh de la liste
    }

    private void OpenModal(Film film)
    {
        selectedFilm = film;
    }

    private void CloseModal()
    {
        selectedFilm = null;
    }

    private void OpenDeleteModal(Film film)
    {
        filmToDelete = film;
    }

    private void ConfirmDelete()
    {
        if (filmToDelete != null)
        {
            AdoFilm.delete(filmToDelete.id);
            @* data = data!.Where(f => f.Id_film != filmToDelete.Id_film).ToList(); *@
            data = AdoFilm.getAll();
        }

        filmToDelete = null;
    }

    private void CloseDeleteModal()
    {
        filmToDelete = null;
    }

}
