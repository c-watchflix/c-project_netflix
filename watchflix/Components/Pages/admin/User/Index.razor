@page "/admin/user"
@rendermode InteractiveServer
@implements IDisposable
@using watchflix.Models
@using watchflix.Repositories
@using Microsoft.Data.SqlClient
@using System.Threading
@inject AdoUser Repo
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Utilisateurs - Admin Panel</PageTitle>

@if (imagesFond.Any())
{
    <div class="dashboard-bg" style="background-image: url('@imagesFond[indexImageActuelle]');"></div>
}

<div class="user-container">
    
    <div class="header-glass">
        <h2 class="m-0 fw-bold" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5); white-space: nowrap;">👥 Gestion des Utilisateurs</h2>

        <div class="search-pill mx-lg-4">
            <span style="margin-right: 10px; opacity: 0.6;">🔍</span>
            <input class="search-input" type="search" placeholder="Rechercher par nom ou prénom..." @bind="wordSearch" @bind:event="oninput">
        </div>
        
        <button class="btn-glass-add" @onclick='() => Nav.NavigateTo("admin/user.create")'>
            ➕ Nouvel Utilisateur
        </button>
    </div>

    <div class="table-glass-container">
        <table class="table-glass">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    
                    <th @onclick='() => Sort("Nom")' style="cursor:pointer">
                        Nom @SortIcon("Nom")
                    </th>

                    <th @onclick='() => Sort("Prenom")' style="cursor:pointer">
                        Prénom @SortIcon("Prenom")
                    </th>

                    <th @onclick='() => Sort("Courriel")' style="cursor:pointer">
                        Mail @SortIcon("Courriel")
                    </th>

                    <th @onclick='() => Sort("Pseudo")' style="cursor:pointer">
                        Pseudo @SortIcon("Pseudo")
                    </th>
                    
                    <th class="text-center" scope="col">Admin</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (dataSearch != null && dataSearch.Any())
                {
                    @foreach (var user in dataSearch) 
                    {
                        string adminIcon = user.Is_admin ? "⭐️" : "";
                        
                        <tr>
                            <td style="opacity: 0.5; font-weight: bold;">@user.Id</td>
                            <td class="fw-bold">@user.Nom</td>
                            <td>@user.Prenom</td>
                            <td style="opacity: 0.8;">@user.Courriel</td>
                            <td style="opacity: 0.8;">@user.Pseudo</td>
                            <td class="text-center">@adminIcon</td>
                            <td> 
                                <div class="action-buttons">
                                    <button class="btn-action btn-update" @onclick='() => Nav.NavigateTo($"admin/user.update/{user.Id}")'>✏️ Editer</button>
                                    
                                    <button class="btn-action btn-delete" @onclick="() => delete(user.Id)">🗑️ Supprimer</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="opacity: 0.5;">
                            Aucun utilisateur trouvé.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    IEnumerable<User>? data = AdoUser.getAll();
    string wordSearch = "";
    string currentSortColumn = "";
    bool asc = true;

    private List<string> imagesFond = new List<string>();
    private int indexImageActuelle = 0;
    private Timer? timerCarrousel;

    protected override async Task OnInitializedAsync()
    {
        await ChargerImagesFond();

        if (imagesFond.Count > 1)
        {
            timerCarrousel = new Timer(ChangerImageBackground, null, 3000, 3000);
        }
    }

    private async Task ChargerImagesFond()
    {
        string connectionString = watchflix.Repositories.Ado.cs;
        try
        {
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                await conn.OpenAsync();
                using (SqlCommand cmd = new SqlCommand("SELECT fond FROM Film WHERE fond IS NOT NULL AND fond != '' AND fond != 'N/A'", conn))
                using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        if (!reader.IsDBNull(0))
                        {
                            string fond = reader.GetString(0);
                            if (fond.StartsWith("/")) fond = $"https://image.tmdb.org/t/p/w1280{fond}";
                            if (!imagesFond.Contains(fond)) imagesFond.Add(fond);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement images : {ex.Message}");
        }
    }

    private void ChangerImageBackground(object? state)
    {
        if (imagesFond.Any())
        {
            indexImageActuelle = (indexImageActuelle + 1) % imagesFond.Count;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        timerCarrousel?.Dispose();
    }

    void Sort(string column)
    {
        if (currentSortColumn == column)
            asc = !asc;
        else
            asc = true;

        currentSortColumn = column;

        if (data != null)
        {
            data = column switch
            {
                "Nom" => asc ? data.OrderBy(u => u.Nom).ToList() : data.OrderByDescending(u => u.Nom).ToList(),
                "Prenom" => asc ? data.OrderBy(u => u.Prenom).ToList() : data.OrderByDescending(u => u.Prenom).ToList(),
                "Courriel" => asc ? data.OrderBy(u => u.Courriel).ToList() : data.OrderByDescending(u => u.Courriel).ToList(),
                "Pseudo" => asc ? data.OrderBy(u => u.Pseudo).ToList() : data.OrderByDescending(u => u.Pseudo).ToList(),
                _ => data
            };
        }
    } 

    private async Task delete (int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer cet utilisateur ?"
        );

        if (!confirm)
            return;

        AdoUser.delete(id);
        data = AdoUser.getAll(); 
    }

    IEnumerable<User> dataSearch => data?.Where(i => 
        (i.Nom?.Contains(wordSearch, StringComparison.OrdinalIgnoreCase) ?? false) || 
        (i.Prenom?.Contains(wordSearch, StringComparison.OrdinalIgnoreCase) ?? false)) 
        ?? Enumerable.Empty<User>();

    RenderFragment SortIcon(string column) => builder =>
    {
        if (currentSortColumn == column)
        {
            var icon = asc ? "bi-arrow-up-short" : "bi-arrow-down-short";
            builder.OpenElement(0, "i");
            builder.AddAttribute(1, "class", $"bi {icon}");
            builder.AddContent(2, " ");
            builder.CloseElement();
        }
    }; 
}