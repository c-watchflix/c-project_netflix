@page "/admin/user.update/{Id:int}"
@rendermode InteractiveServer
@using watchflix.Models
@using watchflix.Repositories
@inject AdoUser Repo
@inject NavigationManager Navigation

<PageTitle>Modification Utilisateur - Admin Panel</PageTitle>

<div class="dashboard-bg"></div>

<div class="form-container">
    <div class="glass-panel">

        <h2 class="fw-bold mb-4" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">✏️ Modification de l'utilisateur</h2>
        
        @if(user != null)
        {
            <p class="text-white-50 mb-5">Mise à jour des informations pour le compte de <strong>@user.Pseudo</strong>.</p>

            <form>
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="glass-label">Nom</label>
                        <input class="glass-input" @bind="user.Nom" />
                    </div>
                    <div class="col-md-6">
                        <label class="glass-label">Prénom</label>
                        <input class="glass-input" @bind="user.Prenom" />
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="glass-label">Email</label>
                        <input type="email" class="glass-input" @bind="user.Courriel" />
                    </div>
                    <div class="col-md-6">
                        <label class="glass-label">Pseudo</label>
                        <input class="glass-input" @bind="user.Pseudo" />
                    </div>
                </div>

                <div class="row g-4 mb-5 align-items-end">
                    <div class="col-md-6">
                        <label class="glass-label">Mot de passe</label>
                        <input type="password" class="glass-input" @bind="user.Mdp" />
                    </div>
                    <div class="col-md-6 pb-2">
                        <div class="form-check d-flex align-items-center">
                            <input type="checkbox" class="form-check-input shadow-none" id="adminCheckUpdate" @bind="user.Is_admin" />
                            <label class="form-check-label text-white" for="adminCheckUpdate">
                                Droits Administrateur
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-end mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.1);">
                    <button type="button" class="btn-glass-cancel" @onclick='() => Navigation.NavigateTo("/admin/user")'>
                        Annuler
                    </button>
                    <button type="button" class="btn-glass-submit" @onclick="update">
                        💾 Enregistrer
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="text-center py-5">
                <h4 class="text-white-50">Chargement des données...</h4>
            </div>
        }

    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private User? user;

    protected override void OnInitialized()
    {
        user = AdoUser.getOneById(Id)?.FirstOrDefault();
    }

    private void update()
    {
        if(user != null)
        {
            AdoUser.update(user);
        }
        Navigation.NavigateTo("/admin/user");
    }
}