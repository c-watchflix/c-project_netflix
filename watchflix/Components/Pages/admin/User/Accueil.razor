@page "/user"
@rendermode InteractiveServer
@using watchflix.Models
@using watchflix.Repositories
@inject AdoUser Repo
@inject IJSRuntime JS

<PageTitle>User</PageTitle>

<h5>Ici test user !</h5>

<button class="btn btn-primary" @onclick="GetAll">getAll</button>
<button class="btn btn-primary" @onclick="getOneById">getOneById</button>
<button class="btn btn-primary" @onclick="getOneByName">getOneByName</button>


<NavLink class="nav-link" href="user.create">
    <span class="bi bi-list-nav-menu" aria-hidden="true"></span> create
</NavLink>


@if (data != null)
{
    <ul>
        @foreach (var user in data)
        {
            <li>
                @user.Nom 
                @user.Prenom
                @user.Courriel
                @user.Pseudo

            </li>
            <NavLink class="btn btn-warning btn-sm" href="@($"/user.update/{user.Id}")"> update </NavLink>

            <button class="btn btn-danger btn-sm"
                    @onclick="() => delete(user.Id)">
                Delete
            </button>

        }
    </ul>
}


@if (OneByName != null)
{
    <ul>
        @foreach (var user in OneByName)
        {
            <li>@user.Nom</li>
        }
    </ul>
}


@if (OneById != null)
{
    <ul>
        @foreach (var user in OneById)
        {
            <li>@user.Nom</li>
        }
    </ul>
}


@code {
    IEnumerable<User>? data;
    IEnumerable<User>? OneByName; 
    IEnumerable<User>? OneById;  


    private void GetAll()
    {
        data = AdoUser.getAll();
    }

    private void getOneByName()
    {   
        OneByName = AdoUser.getOneByName("li");
    }

    private void getOneById()
    {   
        OneById = AdoUser.getOneById(4);
    }

    private async Task delete (int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
        "confirm",
        "Voulez-vous vraiment supprimer cet utilisateur ?"
        );

        if (!confirm)
            return;

        AdoUser.delete(id);

        // Recharger la liste après suppression
        data = AdoUser.getAll();
    }


}