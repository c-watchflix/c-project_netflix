@page "/admin"
@layout watchflix.Components.Layout.AdminLayout
@using watchflix.Models
@using Microsoft.Data.SqlClient
@using System.Threading
@rendermode InteractiveServer

<div style="display:none;" aria-hidden="true">
    @foreach (var imgUrl in imagesFond)
    {
        <img src="@imgUrl" alt="preload" />
    }
</div>

@if (imagesFond.Any())
{
    <div class="dashboard-bg" style="background-image: url('@imagesFond[indexImageActuelle]');"></div>
}

<div class="dashboard-container">
    <h1 class="mb-5" style="font-weight: 800; text-shadow: 0 4px 15px rgba(0,0,0,0.8); letter-spacing: 1px;">
        Tableau de Bord Administrateur WatchFlix
    </h1>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="glass-card text-center d-flex flex-column justify-content-center">
                <div class="stat-value">@nbUtilisateurs</div>
                <div class="stat-label">Utilisateurs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card text-center d-flex flex-column justify-content-center">
                <div class="stat-value">@nbAdmins</div>
                <div class="stat-label">Administrateurs</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card text-center d-flex flex-column justify-content-center">
                <div class="stat-value">@nbFilms</div>
                <div class="stat-label">Films en BDD</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card text-center d-flex flex-column justify-content-center">
                <div class="stat-value">@dureeTotale</div>
                <div class="stat-label">Durée de la collection</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="glass-card">
                <h4 class="mb-5 text-center fw-bold text-white-50">Répartition des films par catégorie</h4>
                
                <div class="donut-wrapper">
                    <div class="donut-chart" style="background: conic-gradient(@GenerateConicGradient());">
                        <div class="donut-center-text">
                            <h3 class="m-0 fw-bold">@nbFilms</h3>
                            <small class="text-white-50">Films Total</small>
                        </div>
                    </div>
                    
                    <div class="legend-container">
                        @foreach (var stat in statsCategories)
                        {
                            <div class="legend-item">
                                <div class="legend-color" style="background-color: @stat.Color;"></div>
                                <span class="fw-bold">@stat.Name</span>
                                <span class="text-white-50">(@stat.Count)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int nbUtilisateurs = 0;
    private int nbAdmins = 0;
    private int nbFilms = 0;
    private string dureeTotale = "0h";

    private List<string> imagesFond = new List<string>();
    private int indexImageActuelle = 0;
    private Timer? timerCarrousel;

    private List<CategoryStat> statsCategories = new List<CategoryStat>();

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonneesReelles();

        if (imagesFond.Count > 1)
        {
            timerCarrousel = new Timer(ChangerImageBackground, null, 3000, 3000);
        }
    }

    private async Task ChargerDonneesReelles()
    {
        string connectionString = watchflix.Repositories.Ado.cs;

        try 
        {
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                await conn.OpenAsync();

                using (SqlCommand cmd = new SqlCommand("SELECT COUNT(*) FROM Utilisateur WHERE is_admin = 0", conn))
                {
                    nbUtilisateurs = (int)(await cmd.ExecuteScalarAsync() ?? 0);
                }

                using (SqlCommand cmd = new SqlCommand("SELECT COUNT(*) FROM Utilisateur WHERE is_admin = 1", conn))
                {
                    nbAdmins = (int)(await cmd.ExecuteScalarAsync() ?? 0);
                }

                using (SqlCommand cmd = new SqlCommand("SELECT COUNT(*) FROM Film", conn))
                {
                    nbFilms = (int)(await cmd.ExecuteScalarAsync() ?? 0);
                }

                TimeSpan totalTime = TimeSpan.Zero;
                using (SqlCommand cmd = new SqlCommand("SELECT duree_film FROM Film WHERE duree_film IS NOT NULL AND duree_film != '' AND duree_film != 'N/A'", conn))
                using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync()) 
                    {
                        if (!reader.IsDBNull(0))
                        {
                            string dureeStr = reader.GetString(0);
                            if (TimeSpan.TryParse(dureeStr, out TimeSpan ts))
                            {
                                totalTime = totalTime.Add(ts);
                            }
                        }
                    }
                }
                dureeTotale = $"{(int)totalTime.TotalHours}h {totalTime.Minutes:D2}m";

                imagesFond.Clear();
                using (SqlCommand cmd = new SqlCommand("SELECT fond FROM Film WHERE fond IS NOT NULL AND fond != '' AND fond != 'N/A'", conn))
                using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync()) 
                    {
                        if (!reader.IsDBNull(0))
                        {
                            string fond = reader.GetString(0);
                            if (fond.StartsWith("/")) fond = $"https://image.tmdb.org/t/p/w1280{fond}";
                            if (!imagesFond.Contains(fond)) imagesFond.Add(fond);
                        }
                    }
                }

                statsCategories.Clear();
                string queryCats = @"
                    SELECT c.libelle, COUNT(cf.id_film) as Count 
                    FROM Categorie c 
                    INNER JOIN categorie_film cf ON c.id_categorie = cf.id_categorie 
                    GROUP BY c.libelle 
                    ORDER BY Count DESC";
                
                string[] palette = new[] { "#e74c3c", "#3498db", "#f1c40f", "#9b59b6", "#2ecc71", "#e67e22", "#1abc9c", "#e84393", "#34495e", "#d35400" };
                int colorIndex = 0;
                
                using (SqlCommand cmd = new SqlCommand(queryCats, conn))
                using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync()) 
                    {
                        if (!reader.IsDBNull(0) && !reader.IsDBNull(1))
                        {
                            statsCategories.Add(new CategoryStat {
                                Name = reader.GetString(0),
                                Count = reader.GetInt32(1),
                                Color = palette[colorIndex % palette.Length]
                            });
                            colorIndex++;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur BDD : {ex.Message}");
        }
    }

    private void ChangerImageBackground(object? state)
    {
        indexImageActuelle = (indexImageActuelle + 1) % imagesFond.Count;
        InvokeAsync(StateHasChanged); 
    }

    private string GenerateConicGradient()
    {
        if (!statsCategories.Any()) return "transparent 0";

        int total = statsCategories.Sum(s => s.Count);
        if (total == 0) return "transparent 0";

        var gradientParts = new List<string>();
        double currentPercentage = 0;

        foreach (var stat in statsCategories)
        {
            double percentage = (double)stat.Count / total * 100.0;
            double nextPercentage = currentPercentage + percentage;
            
            string pctStr = currentPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture);
            string nextPctStr = nextPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture);
            
            gradientParts.Add($"{stat.Color} {pctStr}% {nextPctStr}%");
            currentPercentage = nextPercentage;
        }

        return string.Join(", ", gradientParts);
    }

    public void Dispose()
    {
        timerCarrousel?.Dispose();
    }

    private class CategoryStat
    {
        public string Name { get; set; } = "";
        public int Count { get; set; }
        public string Color { get; set; } = "";
    }
}