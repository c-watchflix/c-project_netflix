@page "/test-categorie"
@rendermode InteractiveServer
@using watchflix.Models
@using watchflix.Repositories
@inject AdoCategorie Repo

<PageTitle>Catégorie</PageTitle>

<h1>Ici test Catégorie !</h1>

<button class="btn btn-primary" @onclick="GetAll">select all</button>
<button class="btn btn-primary"@onclick="GetOneByID">select id</button>
<button class="btn btn-primary"@onclick="GetOneByLibelle">select 1 by name</button>

@if (data != null) //si la liste data n'est pas vide
{
    <h1>Toutes les catégories</h1>
    <ul>
        @foreach (var categorie in data) // alors pour chaque catégorie présente dans la liste
        {
            <li>@categorie.Libelle</li> // je vais faire une ligne
        }
    </ul>
}
@if (OneByID != null) //si la liste data n'est pas vide
{
    <h1>ID de Films</h1>
    <ul>
        @foreach (var categorie in OneByID) // alors pour chaque catégorie présente dans la liste
        {
            <li>@categorie.Libelle</li> // je vais faire une ligne
        }
    </ul>
}
@if (OneByLibelle != null) //si la liste data n'est pas vide
{
    <h1>Noms des films</h1>
    <ul>
        @foreach (var categorie in OneByLibelle) // alors pour chaque catégorie présente dans la liste
        {
            <li>@categorie.Libelle</li> // je vais faire une ligne
        }
    </ul>
}
@code {
    IEnumerable<Categorie>? data;
    IEnumerable<Categorie>? OneByID;
    IEnumerable<Categorie>? OneByLibelle;
   
    private void GetAll()
{
    data = AdoCategorie.getAll();
}
private void GetOneByID()
{
    OneByID = AdoCategorie.getOneByID(7);
}
private void GetOneByLibelle()
{
   OneByLibelle = AdoCategorie.getOneByLibelle("Jeunesse"); 
}

}
