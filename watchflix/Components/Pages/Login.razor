@page "/login"
@layout watchflix.Components.Layout.EmptyLayout
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject IJSRuntime JS

<PageTitle>Connexion - WatchFlix</PageTitle>

<div class="login-master-wrapper">
    
    <div style="display:none;" aria-hidden="true">
        @foreach (var img in jaquettes)
        {
            <img src="@img" alt="preload" />
        }
    </div>

    <div class="earth-bg"></div>

    @if (colonnesDeJaquettes.Any())
    {
        <div class="scrolling-wrapper">
            @for (int i = 0; i < colonnesDeJaquettes.Count; i++)
            {
                <div class="poster-column col-speed-@((i % 7) + 1)">
                    @foreach (var img in colonnesDeJaquettes[i]) { <img src="@img" /> }
                    @foreach (var img in colonnesDeJaquettes[i]) { <img src="@img" /> }
                    @foreach (var img in colonnesDeJaquettes[i]) { <img src="@img" /> }
                    @foreach (var img in colonnesDeJaquettes[i]) { <img src="@img" /> }
                </div>
            }
        </div>
    }

    <div class="login-page-container">
        <div class="glass-login-box">
            
            <h1 class="brand-title">🎬 WatchFlix</h1>
            <h3>Espace Connexion</h3>

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                
                <div class="mb-4 text-start">
                    <label class="glass-label">Identifiant</label>
                    <InputText class="glass-input form-control" placeholder="Saisissez votre pseudo..." @bind-Value="loginModel.Pseudo" />
                    <ValidationMessage For="@(() => loginModel.Pseudo)" />
                </div>

                <div class="mb-4 text-start">
                    <label class="glass-label">Mot de passe</label>
                    <InputText class="glass-input form-control" type="password" placeholder="••••••••" @bind-Value="loginModel.Password" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <button type="submit" class="btn-glass-login" disabled="@isLoading" @onclick="LancerConfettis">
                    @if (isLoading)
                    {
                        <span>Vérification...</span>
                    }
                    else
                    {
                        <span>Se connecter</span>
                    }
                </button>
            </EditForm>

            <div class="text-center mt-4">
                <p class="text-white-50">Vous n'avez pas de compte ? <a href="/register" style="color: #00d4ff; text-decoration: none; font-weight: bold;">Créer un compte</a></p>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="mt-4 p-3" style="background: rgba(231, 76, 60, 0.2); border: 1px solid rgba(231, 76, 60, 0.5); color: #ffcccc; border-radius: 12px; font-weight: bold;">
                    @ErrorMessage
                </div>
            }
        </div>
    </div>

</div>

@code {
    private LoginModel loginModel = new();
    private string ErrorMessage = string.Empty;
    private bool isLoading = false;

    private List<string> jaquettes = new List<string>();
    private List<List<string>> colonnesDeJaquettes = new List<List<string>>();

    protected override void OnInitialized()
    {
        ChargerJaquettes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string scriptConfetti = @"
                window.explodeCinemaConfetti = function () {
                    const emojis = ['🍿', '🎬', '🎥', '⭐', '🎟️', '🎞️'];
                    const numParticles = 35;
                    
                    for (let i = 0; i < numParticles; i++) {
                        let conf = document.createElement('div');
                        conf.innerText = emojis[Math.floor(Math.random() * emojis.length)];
                        conf.style.position = 'fixed';
                        conf.style.left = '50%';
                        conf.style.top = '65%'; 
                        conf.style.fontSize = (Math.random() * 20 + 20) + 'px';
                        conf.style.zIndex = '99999';
                        conf.style.pointerEvents = 'none';
                        conf.style.opacity = '1';
                        document.body.appendChild(conf);

                        let angle = Math.random() * Math.PI * 2;
                        let distance = 150 + Math.random() * 250; 
                        let moveX = Math.cos(angle) * distance;
                        let moveY = (Math.sin(angle) * distance) - 150; 
                        let rotation = Math.random() * 720 - 360;

                        void conf.offsetWidth;

                        conf.style.transition = 'transform 3s cubic-bezier(0.1, 0.8, 0.3, 1), opacity 3s ease-in';
                        
                        conf.style.transform = `translate(${moveX}px, ${moveY}px) rotate(${rotation}deg)`;
                        conf.style.opacity = '0'; 

                        setTimeout(() => conf.remove(), 3000); 
                    }
                }
            ";
            await JS.InvokeVoidAsync("eval", scriptConfetti);
        }
    }

    private void ChargerJaquettes()
    {
        // 42 Jaquettes 100% vérifiées et fonctionnelles (Populaires TMDB)
        jaquettes = new List<string>
        {
            "https://image.tmdb.org/t/p/w500/8cdWjvZQUExUUTzyp4t6EDMubfO.jpg", 
            "https://image.tmdb.org/t/p/w500/7WsyChQLEftFiDOVTGkv3hFpyyt.jpg", 
            "https://image.tmdb.org/t/p/w500/mBaXZ95R2OxueZhvQbcEWy2DqyO.jpg", 
            "https://image.tmdb.org/t/p/w500/glKDfE6btIRcVB5zrjspRIs4r52.jpg", 
            "https://image.tmdb.org/t/p/w500/8UlWHLMpgZm9bx6QYh0NFoq67TZ.jpg", 
            "https://image.tmdb.org/t/p/w500/8Gxv8gSFCU0XGDykEGv7zR1n2ua.jpg", 
            "https://image.tmdb.org/t/p/w500/iuFNMS8U5cb6xfzi51Dbkovj7vM.jpg", 
            "https://image.tmdb.org/t/p/w500/q6y0Go1tsGEsmtFryDOJo3dEmqu.jpg", 
            "https://image.tmdb.org/t/p/w500/saHP97rTPS5eLmrLQEcANmKrsFl.jpg", 
            "https://image.tmdb.org/t/p/w500/f89U3ADr1oiB1s9GkdPOEpXUk5H.jpg", 
            "https://image.tmdb.org/t/p/w500/bptfVGEQuv6vDTIMVCHjJ9Dz8PX.jpg", 
            "https://image.tmdb.org/t/p/w500/7IiTTgloJzvGI1TAYymCfbfl3vT.jpg", 
            "https://image.tmdb.org/t/p/w500/xBHvZcjRiWyobQ9kxBhO6B2dtRI.jpg", 
            "https://image.tmdb.org/t/p/w500/qJ2tW6WMUDux911r6m7haRef0WH.jpg", 
            "https://image.tmdb.org/t/p/w500/or06FN3Dka5tukK1e9sl16pB3iy.jpg", 
            "https://image.tmdb.org/t/p/w500/q719jXXEzOoYaps6babgKnONONX.jpg", 
            "https://image.tmdb.org/t/p/w500/iCgFtDUZxN8iUzNBCisjUrBmg2q.jpg",
            "https://image.tmdb.org/t/p/w500/rcFafbWECDkXQyHNphNSfWh6WQw.jpg",
            "https://image.tmdb.org/t/p/w500/i268GVIlp777W1Ykws5R3LYYLIw.jpg",
            "https://image.tmdb.org/t/p/w500/gUY5B8OaRqPnLUwjNxITUTrPbIN.jpg",
            "https://image.tmdb.org/t/p/w500/fbxQ44VRdM2PVzHSNajUseUteem.jpg",
            "https://image.tmdb.org/t/p/w500/dQIQZbJXn1pflQw3nwvXLJX0dHa.jpg",
            "https://image.tmdb.org/t/p/w500/832ngDVXhOVp6HBnuMMeeWTrGXN.jpg",
            "https://image.tmdb.org/t/p/w500/cnniZQGtjK8kh2tsjih4GtkX6bl.jpg",
            "https://image.tmdb.org/t/p/w500/aSQktALDmbunDbwkuZbZFMEWVFr.jpg",
            "https://image.tmdb.org/t/p/w500/zdVxpaoQdpheQqWWd6b82eY9Pid.jpg",
            "https://image.tmdb.org/t/p/w500/vpsvHLkoeKUjceIMeNSqCp3xEyY.jpg",
            "https://image.tmdb.org/t/p/w500/apTFre4duDr92xJgsAts55OeHs1.jpg",
            "https://image.tmdb.org/t/p/w500/tWmEsB3MtN7RfdXphzghC8B3ahX.jpg",
        };

        // On coupe précisément la liste de 42 films en 7 colonnes parfaites de 6 films.
        // Résultat : Il est physiquement impossible d'avoir des doublons horizontaux !
        int nbColonnes = 7;
        int imagesParColonne = jaquettes.Count / nbColonnes; 

        for (int i = 0; i < nbColonnes; i++)
        {
            var colImages = jaquettes.Skip(i * imagesParColonne).Take(imagesParColonne).ToList();
            colonnesDeJaquettes.Add(colImages);
        }
    }

    private async Task LancerConfettis()
    {
        try { await JS.InvokeVoidAsync("explodeCinemaConfetti"); } catch { }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = string.Empty;
        isLoading = true;

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(loginModel);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            
            var response = await HttpClient.PostAsync("https://localhost:7275/api/auth/login", content);

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "L'identifiant ou le mot de passe est incorrect.";
                isLoading = false;
                return;
            }

            NavigationManager.NavigateTo("/ma-videotheque", true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur serveur: Veuillez réessayer plus tard.";
            Console.WriteLine(ex.Message); 
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "L'identifiant est requis pour vous connecter.")]
        public string Pseudo { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le mot de passe est requis pour vous connecter.")]
        public string Password { get; set; } = string.Empty;
    }
}